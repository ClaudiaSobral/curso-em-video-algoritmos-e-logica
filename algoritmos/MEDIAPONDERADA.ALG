Algoritmo "mediaPonderada"
Var
   Nota1, Nota2, Nota3, Media: Real

Inicio
      Escreval("Digite Nota 1: ")
      Leia(Nota1)
      Escreval("Digite Nota 2: ")
      Leia(Nota2)
      Escreval("Digite Nota 3: ")
      Leia(Nota3)
      Media <- (Nota1 * 2 + Nota2 * 3 + Nota3 * 5) / 3
      Escreva("A média ponderada de ", Nota1, ", ", Nota2, ", ", Nota3, " é ", Media)


Fimalgoritmo