Algoritmo "calculaAno"
Var
   anoAtual, anoNascimento, idade: Inteiro

Inicio
      Escreva("Ano de nascimento da pessoa: ")
      Leia(anoNascimento)
      Escreva("Ano atual: ")
      Leia(anoAtual)
      idade <- anoAtual - anoNascimento
      Escreva("A idade da pessoa é: ", idade)

Fimalgoritmo